# Copy to .env for local development. Production reads the same names from the host's secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://metly:metly@127.0.0.1:54329/metly

# Public origins. Printed QR codes encode WEB_BASE_URL — it must never change once cards are shared.
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# How far to trust X-Forwarded-For for the client IP (rate limits): proxy hop count ("1" behind one
# load balancer, e.g. Render/Fly/Railway), a subnet list ("loopback, 10.0.0.0/8"), or "false" when
# clients connect directly. "true" is refused (anyone could pick their own IP).
TRUST_PROXY=1
# Shared secret of the Cloudflare Worker that serves WEB_BASE_URL in front of this API
# (infra/cloudflare/web-proxy). Same value as the Worker's EDGE_PROXY_SECRET. Empty → not used.
EDGE_PROXY_SECRET=
# Rate-limit counters: "postgres" (shared by all instances, default) or "memory" (one process).
RATE_LIMIT_STORE=postgres

# 32+ random bytes, base64. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=60

# Sign in with Apple / Google. Comma-separated audiences (release + debug bundle ids).
APPLE_BUNDLE_IDS=app.nameshake.ios,com.azizjon.metly
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
GOOGLE_CLIENT_IDS=

# Development only: POST /v1/auth/dev signs in without Apple/Google. Never enable in production.
DEV_AUTH_ENABLED=true

# APNs (token auth, .p8). Empty → pushes are logged instead of sent.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=app.nameshake.ios

# App Store Server API + notifications. Empty → /v1/subscriptions/verify returns 503.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_APP_APPLE_ID=
APP_STORE_ENVIRONMENT=Sandbox

# Apple Wallet. Empty → wallet-pass returns 503.
PASS_TYPE_IDENTIFIER=pass.app.nameshake.ios.card
PASS_TEAM_ID=
PASS_CERT_PEM=
PASS_KEY_PEM=
PASS_KEY_PASSPHRASE=
PASS_WWDR_PEM=

# S3-compatible storage for profile photos and logos (R2, S3, B2…). Empty → uploads return 503.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Log In with Telegram (OIDC): @BotFather → your bot → Login Widget → Client ID / Client Secret.
# Register {API_BASE_URL}/v1/auth/telegram/callback there as an Allowed URL. Empty → Telegram sign-in returns 503.
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# The app's URL scheme; the sign-in callback returns the code to the app through it.
APP_URL_SCHEME=nameshake

# "Notify me" link for Android visitors on card pages (e.g. a waitlist form). Empty → hidden.
ANDROID_WAITLIST_URL=

# App Store id for the Smart App Banner on card pages (after the first release).
APP_STORE_ID=
# Before that: where "Get the app" leads, e.g. the TestFlight public link. Empty → the button is hidden.
APP_DOWNLOAD_URL=

# Transactional mail via Resend (data export links). Empty → exports stay queued.
RESEND_API_KEY=
MAIL_FROM=Nameshake <no-reply@tanishly.app>
