          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь экрана блокировки и удерживайте, затем выберите «Настроить»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qulf ekranini bosib turing, so‘ng “Moslash”ni bosing."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaytarish"
          }
        }
      }
    },
    "Website": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Veb-sayt"
          }
        }
      }
    },
    "Widgets": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidjetlar"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecha"
          }
        }
      }
    },
    "You can also put it on the Lock Screen or the Action button.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его также можно добавить на экран блокировки или на кнопку действия."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni Qulf ekraniga yoki Harakat tugmasiga ham qo‘yishingiz mumkin."
          }
        }
      }
    },
    "Your Name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismingiz"
          }
        }
      }
    },
    "Your QR on the Lock Screen. Anyone can scan it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш QR-код на экране блокировки. Его может отсканировать любой."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qulf ekranidagi QR kodingiz. Uni istalgan kishi skanerlay oladi."
          }
        }
      }
    },
    "Your QR shows right on the Lock Screen, so people can scan it without you unlocking. Tap it to open it full screen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-код отображается прямо на экране блокировки, поэтому его можно отсканировать, не разблокируя телефон. Коснитесь его, чтобы открыть на весь экран."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodingiz to‘g‘ridan-to‘g‘ri Qulf ekranida ko‘rinadi, shuning uchun uni qurilmani ochmasdan skanerlash mumkin. To‘liq ekranda ochish uchun ustiga bosing."
          }
        }
      }
    },
    "Your QR, one tap away.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш QR-код — в одно касание."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodingiz bir bosishda."
          }
        }
      }
    },
    "Your card and this week's new connections. Tap to show your QR.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша визитка и новые контакты за неделю. Коснитесь, чтобы показать QR-код."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangiz va shu haftadagi yangi tanishlar. QR kodni ko‘rsatish uchun bosing."
          }
        }
      }
    },
    "Your default card, or your event's card": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная визитка или визитка мероприятия"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy vizitkangiz yoki tadbir vizitkangiz"
          }
        }
      }
    },
    "via Nearby": {
      "localizations": {
        "ru": {
          "stringUnit": {
