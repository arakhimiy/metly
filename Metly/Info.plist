<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Tanishly uses the camera to scan QR codes and paper business cards.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tanishly finds people nearby who also use Tanishly so you can swap cards.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Tanishly detects when you hold your iPhone near someone else's to swap cards.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_tanishly._tcp</string>
		<string>_tanishly._udp</string>
	</array>
	<key>NSContactsUsageDescription</key>
	<string>Tanishly saves the people you meet to your Contacts when you ask it to.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tanishly uses the microphone to dictate private notes. Audio isn't stored.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Tanishly turns your voice into a private note on your iPhone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Tanishly saves card images and Lock Screen wallpapers to your Photos.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Tanishly suggests events from your calendar so new contacts are tagged automatically.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tanishly fills in where you met someone. Your location is never shared.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
		<string>whatsapp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.tanishly.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tanishly</string>
			</array>
		</dict>
	</array>
	<key>MetlyGoogleClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>MetlyAppGroup</key>
	<string>$(METLY_APP_GROUP)</string>
	<key>MetlyAPIBaseURL</key>
	<string>$(METLY_API_BASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.tanishly.ios.refresh</string>
		<string>app.tanishly.ios.sync</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain HTTP only to the local network (a development backend on this Mac); the internet stays HTTPS-only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
