    "%@ %@ density shows up to %lld contact lines, so ^[%lld contact](inflect: true) won’t fit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ density shows up to %3$lld contact lines, so ^[%4$lld contact](inflect: true) won’t fit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ При плотности «%2$@» видно до %3$lld строк контактов, поэтому часть контактов (%4$lld) не поместится."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ «%2$@» zichligida ko‘pi bilan %3$lld ta kontakt qatori ko‘rinadi, shuning uchun %4$lld ta kontakt sig‘maydi."
          }
        }
      }
    },
    "%@ %@ density shows up to %lld contact lines, so ^[%lld field](inflect: true) won’t fit.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ density shows up to %3$lld contact lines, so ^[%4$lld field](inflect: true) won’t fit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ При плотности «%2$@» видно до %3$lld строк контактов, поэтому часть полей (%4$lld) не поместится."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ «%2$@» zichligida ko‘pi bilan %3$lld ta kontakt qatori ko‘rinadi, shuning uchun %4$lld ta maydon sig‘maydi."
          }
        }
      }
    },
