        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tadbirlaringizni shu yerda ko‘rish uchun Sozlamalarda taqvimga to‘liq ruxsat bering."
          }
        }
      }
    },
    "Allow microphone access in Settings › %@ to add notes by voice.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавлять заметки голосом, разрешите доступ к микрофону в Настройках › %@."
