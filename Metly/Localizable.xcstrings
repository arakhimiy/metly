    },
    "%@ is your default": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — теперь основная визитка"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ endi asosiy vizitka"
          }
        }
      }
    },
    "%@ looks at your calendar on this iPhone only to suggest events. Only the event you pick is saved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ просматривает календарь только на этом iPhone, чтобы предлагать мероприятия. Сохраняется только выбранное вами мероприятие."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tadbirlarni taklif qilish uchun faqat shu iPhone’dagi taqvimingizni ko‘radi. Faqat siz tanlagan tadbir saqlanadi."
          }
        }
      }
    },
    "%@ never sells your data. Notes you write are only visible to you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ никогда не продаёт ваши данные. Ваши заметки видите только вы."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma’lumotlaringizni hech qachon sotmaydi. Siz yozgan izohlarni faqat siz ko‘rasiz."
          }
        }
      }
    },
    "%@ only uses these when you connect or scan. Change them anytime in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ использует их, только когда вы обмениваетесь визитками или сканируете. Изменить это можно в любой момент в Настройках."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ulardan faqat vizitka almashganingizda yoki skanerlaganingizda foydalanadi. Ularni istalgan vaqtda Sozlamalarda o‘zgartirishingiz mumkin."
          }
        }
      }
    },
    "%@ plans couldn’t be loaded from the App Store. Check your connection and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить планы %@ из App Store. Проверьте подключение и повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tariflarini App Store’dan yuklab bo‘lmadi. Internet aloqasini tekshirib, qayta urinib ko‘ring."
          }
        }
      }
    },
