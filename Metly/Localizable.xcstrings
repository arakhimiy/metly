    },
    "The Gradient template is always gradient.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В шаблоне Gradient всегда градиент."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradient shablonida doim gradiyent bo‘ladi."
          }
        }
      }
    },
    "The QR code holds a contact card without a name or contact details.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-код содержит карточку контакта без имени и контактных данных."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodda ism va kontakt ma’lumotlarisiz kontakt kartasi bor."
          }
        }
      }
    },
    "The QR keeps a 4-module quiet zone and error correction level M in every format.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом формате у QR-кода остаются свободное поле в 4 модуля и уровень коррекции ошибок M."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "QR har bir formatda 4 modulli bo‘sh hoshiya va M darajali xatolarni tuzatishni saqlaydi."
          }
        }
      }
    },
    "The bot sends each reminder with a one-tap link to the chat.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бот присылает каждое напоминание со ссылкой на чат в одно касание."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot har bir eslatmani chatga bir bosishda o‘tish havolasi bilan yuboradi."
          }
        }
      }
    },
    "The copied text isn’t a %@ card link. Copy a link like %@/c/… and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The copied text isn’t a %1$@ card link. Copy a link like %2$@/c/… and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст — не ссылка на визитку %1$@. Скопируйте ссылку вида %2$@/c/… и повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Nusxalangan matn %1$@ vizitka havolasi emas. %2$@/c/… kabi havolani nusxalab, qayta urinib ko‘ring."
          }
        }
      }
    },
    "The event also ends by itself after the last day.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мероприятие также завершится само после последнего дня."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tadbir oxirgi kundan keyin o‘zi ham tugaydi."
          }
        }
      }
    },
    "The event can’t end before it starts.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мероприятие не может закончиться раньше, чем начнётся."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tadbir boshlanishidan oldin tugay olmaydi."
          }
        }
      }
    },
    "The event ends by itself after the last day, so pick today or later.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мероприятие завершится само после последнего дня, поэтому выберите сегодняшнюю или более позднюю дату."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tadbir oxirgi kundan keyin o‘zi tugaydi, shuning uchun bugungi yoki keyingi sanani tanlang."
          }
        }
      }
    },
    "The export couldn’t be created. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать файл экспорта. Повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport faylini yaratib bo‘lmadi. Qayta urinib ko‘ring."
          }
        }
      }
    },
    "The first mobile number is saved as the main one.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый мобильный номер сохранится как основной."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinchi mobil raqam asosiy raqam sifatida saqlanadi."
          }
        }
      }
    },
    "The image couldn’t be saved to Photos. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить изображение в «Фото». Повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasmni Rasmlar ilovasiga saqlab bo‘lmadi. Qayta urinib ko‘ring."
          }
        }
      }
    },
    "The microphone couldn’t start. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить микрофон. Попробуйте ещё раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonni ishga tushirib bo‘lmadi. Qayta urinib ko‘ring."
          }
        }
      }
    },
    "The pass couldn’t be read. Try again in a moment.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать карту. Повторите попытку чуть позже."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartani o‘qib bo‘lmadi. Birozdan so‘ng qayta urinib ko‘ring."
          }
        }
      }
    },
    "The request was cancelled.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос отменён."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "So‘rov bekor qilindi."
          }
        }
      }
    },
    "The server sent an unexpected response.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер вернул неожиданный ответ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Server kutilmagan javob yubordi."
          }
        }
      }
    },
    "The server took too long to respond. Try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер слишком долго не отвечал. Повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Server juda uzoq javob bermadi. Qayta urinib ko‘ring."
          }
        }
      }
    },
