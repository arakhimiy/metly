    "%@ didn’t respond. Try again later, or add them to People now.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не отвечает. Повторите попытку позже или добавьте контакт в «Люди» сейчас."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ javob bermadi. Keyinroq qayta urinib ko‘ring yoki hozir Tanishlarga qo‘shing."
          }
        }
      }
    },
    "%@ didn’t respond. Try again or show your QR.": {
      "localizations": {
        "ru": {
