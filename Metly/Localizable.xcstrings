            "state": "translated",
            "value": "Taqvimdan tadbirlarni taklif qilish"
          }
        }
      }
    },
    "Summaries arrive quietly, without sound.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводки приходят тихо, без звука."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
