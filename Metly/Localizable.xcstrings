    "Nearby Interactions are off for %@. Tapping still works, but turning them on makes it more reliable.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взаимодействие с устройствами рядом для %@ выключено. Касание всё равно работает, но с ним оно надёжнее."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uchun yaqin atrofdagi o‘zaro aloqalar o‘chiq. Tegizish baribir ishlaydi, lekin ularni yoqsangiz, yanada ishonchli bo‘ladi."
          }
        }
      }
    },
