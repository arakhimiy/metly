    "Subscriptions are billed through your Apple ID. Cancel at least 24 hours before renewal.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата подписки списывается через ваш Apple ID. Отмените не позднее чем за 24 часа до продления."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obuna to‘lovi Apple ID orqali olinadi. Yangilanishdan kamida 24 soat oldin bekor qiling."
          }
        }
      }
    },
    "Suggest Events From Calendar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагать мероприятия из календаря"
