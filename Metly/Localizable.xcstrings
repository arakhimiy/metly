    "Already have an account?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть аккаунт?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkauntingiz bormi?"
          }
        }
      }
    },
    "Always black on a white plate. Logos never go on the code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда чёрный на белом фоне. Логотипы на код не наносятся."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Doim oq fonda qora. Kod ustiga logotip qo‘yilmaydi."
          }
        }
      }
    },
    "Analytics never include your contacts, notes or the people you meet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналитика никогда не включает ваши контакты, заметки и людей, с которыми вы знакомитесь."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Analitikaga kontaktlaringiz, izohlaringiz va tanishgan odamlaringiz hech qachon kirmaydi."
          }
        }
      }
    },
    "And %lld more. Notes stay private — only you can see them.": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "И ещё %lld человека. Заметки остаются личными — их видите только вы."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "И ещё %lld человек. Заметки остаются личными — их видите только вы."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "И ещё %lld человек. Заметки остаются личными — их видите только вы."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "И ещё %lld человека. Заметки остаются личными — их видите только вы."
                }
              }
            }
          }
        },
        "uz": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Yana %lld kishi. Izohlar shaxsiy qoladi — ularni faqat siz ko‘rasiz."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Yana %lld kishi. Izohlar shaxsiy qoladi — ularni faqat siz ko‘rasiz."
