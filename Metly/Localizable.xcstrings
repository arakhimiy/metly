    "Voice Notes Unavailable": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовые заметки недоступны"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovozli izohlar mavjud emas"
          }
        }
      }
    },
    "Voice notes are recognized on this iPhone, so iOS needs its English dictation model. Go to Settings › General › Keyboard › Dictation Languages and turn on English (add an English keyboard first if it isn’t listed), then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовые заметки распознаются на самом iPhone, поэтому iOS нужна модель английской диктовки. Откройте Настройки › Основные › Клавиатура › Языки диктовки и включите английский (если его нет в списке, сначала добавьте английскую клавиатуру), затем попробуйте ещё раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovozli izohlar shu iPhone’ning o‘zida aniqlanadi, shuning uchun iOS’ga ingliz tilidagi diktovka modeli kerak. Sozlamalar › Umumiy › Klaviatura › Diktovka tillari bo‘limida ingliz tilini yoqing (ro‘yxatda bo‘lmasa, avval inglizcha klaviaturani qo‘shing), so‘ng qayta urinib ko‘ring."
          }
        }
      }
    },
    "Voice notes are recognized on this iPhone, so iOS needs its Russian dictation model. Go to Settings › General › Keyboard › Dictation Languages and turn on Russian (add the Russian keyboard first if it isn’t listed), then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовые заметки распознаются на самом iPhone, поэтому iOS нужна модель русской диктовки. Откройте Настройки › Основные › Клавиатура › Языки диктовки и включите русский (если его нет в списке, сначала добавьте русскую клавиатуру), затем попробуйте ещё раз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovozli izohlar shu iPhone’ning o‘zida aniqlanadi, shuning uchun iOS’ga rus tilidagi diktovka modeli kerak. Sozlamalar › Umumiy › Klaviatura › Diktovka tillari bo‘limida rus tilini yoqing (ro‘yxatda bo‘lmasa, avval rus klaviaturasini qo‘shing), so‘ng qayta urinib ko‘ring."
          }
        }
      }
    },
