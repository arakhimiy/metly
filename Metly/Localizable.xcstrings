          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangizni saqlash uchun iOS sozlamalari › %@ › Rasmlar bo‘limini oching va «Faqat rasm qo‘shish»ni tanlang."
          }
        }
      }
    },
