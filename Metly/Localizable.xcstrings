    },
    "You need at least one card": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна хотя бы одна визитка"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamida bitta vizitka bo‘lishi kerak"
          }
        }
      }
    },
    "You shared your %@ card with %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You shared your %1$@ card with %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отправили визитку «%1$@» контакту %2$@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz “%1$@” vizitkangizni %2$@ bilan ulashdingiz."
          }
        }
      }
    },
    "You won’t be notified when a follow-up is due.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не получите уведомление, когда подойдёт время напоминания."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Eslatma vaqti kelganda sizga xabar berilmaydi."
          }
        }
      }
    },
    "You won’t be reminded to follow up with %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам не будет приходить напоминание связаться с %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bilan bog‘lanish haqida sizga eslatilmaydi."
          }
        }
      }
    },
    "You're offline. Check your connection and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Проверьте подключение и повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oflaynsiz. Internet aloqasini tekshirib, qayta urinib ko‘ring."
          }
        }
      }
    },
    "You're offline. Your QR code still works.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Ваш QR-код всё равно работает."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oflaynsiz. QR kodingiz baribir ishlaydi."
          }
        }
      }
    },
    "Your %@ card and %@’s card": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your %1$@ card and %2$@’s card"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша визитка «%1$@» и визитка контакта %2$@"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizning “%1$@” vizitkangiz va %2$@ning vizitkasi"
          }
        }
      }
    },
    "Your Card Is Live": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Визитка опубликована"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangiz e’lon qilindi"
          }
        }
      }
    },
    "Your Card Is Ready": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша визитка готова"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangiz tayyor"
          }
        }
      }
    },
    "Your Data": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlaringiz"
          }
        }
      }
    },
    "Your Name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismingiz"
          }
        }
      }
    },
    "Your QR note + their web share-back": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша заметка по QR + его ответный контакт с сайта"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "QR izohingiz + uning veb orqali qaytargan kontakti"
          }
        }
      }
    },
    "Your QR shows right on the Lock Screen, so people can scan it without you unlocking. Tap it to open it full screen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-код отображается прямо на экране блокировки, поэтому его можно отсканировать, не разблокируя телефон. Коснитесь его, чтобы открыть на весь экран."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodingiz to‘g‘ridan-to‘g‘ri Qulf ekranida ko‘rinadi, shuning uchun uni qurilmani ochmasdan skanerlash mumkin. To‘liq ekranda ochish uchun ustiga bosing."
          }
        }
      }
    },
    "Your card is saved as a draft and will publish when you’re back online.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Визитка сохранена как черновик и будет опубликована, когда вы снова будете онлайн."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangiz qoralama sifatida saqlandi va internetga ulanganingizda e’lon qilinadi."
          }
        }
      }
    },
    "Your card isn’t published yet, so the QR shares your contact details.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Визитка ещё не опубликована, поэтому QR-код передаёт ваши контактные данные."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangiz hali e’lon qilinmagan, shuning uchun QR kontakt ma’lumotlaringizni ulashadi."
          }
        }
      }
    },
    "Your card isn’t published yet, so the QR shares your contact details. Export again once it’s published to use your link.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Визитка ещё не опубликована, поэтому QR-код передаёт ваши контактные данные. Чтобы использовать ссылку, экспортируйте снова после публикации."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitkangiz hali e’lon qilinmagan, shuning uchun QR kontakt ma’lumotlaringizni ulashadi. Havolangizdan foydalanish uchun u e’lon qilingach, qayta eksport qiling."
          }
        }
      }
    },
    "Your cards will look like they don’t exist to them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого человека ваши визитки будут выглядеть так, будто их не существует."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ular uchun vizitkalaringiz go‘yo mavjud emasdek ko‘rinadi."
          }
        }
      }
    },
    "Your changes to this card won’t be saved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения в этой визитке не будут сохранены."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu vizitkadagi o‘zgarishlaringiz saqlanmaydi."
          }
        }
      }
    },
    "Your default card is used for Connect, events and widgets.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная визитка используется для обмена, мероприятий и виджетов."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy vizitkangiz almashish, tadbirlar va vidjetlar uchun ishlatiladi."
          }
        }
      }
    },
    "Your default card, or your event's card": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная визитка или визитка мероприятия"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy vizitkangiz yoki tadbir vizitkangiz"
          }
        }
      }
    },
    "Your details fill every layout. You can switch any time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные подставляются в любой макет. Его можно сменить в любое время."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlaringiz har bir maketga joylanadi. Istalgan vaqtda almashtirishingiz mumkin."
          }
        }
      }
    },
    "Your link appears in a moment, as soon as the card is published.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка появится, как только визитка будет опубликована."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitka e’lon qilinishi bilan havolangiz paydo bo‘ladi."
          }
        }
      }
    },
    "Your links are paused, so this page shows as unavailable until you resume them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши ссылки приостановлены, поэтому страница будет недоступна, пока вы их не возобновите."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Havolalaringiz to‘xtatilgan, shuning uchun ularni qayta yoqmaguningizcha bu sahifa mavjud emas deb ko‘rinadi."
          }
        }
      }
    },
    "Your name is required. It appears on every card.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите имя. Оно отображается на каждой визитке."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismingizni kiritish shart. U har bir vizitkada ko‘rinadi."
          }
        }
      }
    },
    "Your name, title and company appear on every card.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши имя, должность и компания отображаются на каждой визитке."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismingiz, lavozimingiz va kompaniyangiz har bir vizitkada ko‘rinadi."
          }
        }
      }
    },
    "Your note will be deleted. They keep the card you shared.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша заметка будет удалена. Отправленная вами визитка у человека останется."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Izohingiz o‘chiriladi. Siz ulashgan vizitka ularda qoladi."
          }
        }
      }
    },
    "Your note: “%@”": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша заметка: «%@»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Izohingiz: “%@”"
          }
        }
      }
    },
    "Your public page appears once your default card is published.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша публичная страница появится, когда основная визитка будет опубликована."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ommaviy sahifangiz asosiy vizitkangiz e’lon qilingach paydo bo‘ladi."
          }
        }
      }
    },
    "Your session has expired. Sign in again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс истёк. Войдите снова."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans muddati tugadi. Qayta kiring."
          }
        }
      }
    },
    "Your subscription won’t renew. You keep Pro until %@. Cards beyond two become read-only after that.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка не будет продлена. Pro останется у вас до %@. После этого визитки сверх двух будут доступны только для просмотра."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obunangiz yangilanmaydi. Pro %@ gacha saqlanadi. Shundan keyin ikkitadan ortiq vizitkalarni faqat ko‘rish mumkin bo‘ladi."
          }
        }
      }
    },
    "You’ll get an email with a copy of everything.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите письмо с копией всех данных."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha ma’lumotlaringiz nusxasi email orqali yuboriladi."
          }
        }
      }
    },
    "You’ll share your %@ card.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отправите визитку «%@»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz “%@” vizitkangizni ulashasiz."
          }
        }
      }
    },
    "You’re Connected": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы обменялись визитками"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizitka almashdingiz"
          }
        }
      }
    },
    "You’re Hidden from Nearby": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас не видно в «Рядом»"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz Yaqin atrofda ko‘rinmaysiz"
          }
        }
      }
    },
    "You’re Offline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oflaynsiz"
          }
        }
      }
    },
    "You’re offline, so %@ was saved to People. Connect again when you’re back online.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн, поэтому %@ сохранён(а) в «Люди». Обменяйтесь визитками снова, когда будете онлайн."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oflaynsiz, shuning uchun %@ Tanishlarga saqlandi. Internetga ulanganingizda qayta almashing."
          }
        }
      }
    },
    "You’re offline. Connect to the internet and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Подключитесь к интернету и повторите попытку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz oflaynsiz. Internetga ulanib, qayta urinib ko‘ring."
          }
        }
      }
    },
    "You’re using every active reminder the Free plan includes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы используете все активные напоминания бесплатного плана."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepul tarifdagi barcha faol eslatmalardan foydalanyapsiz."
          }
        }
      }
    },
    "You’ve blocked %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы заблокировали: %@."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz %@ni blokladingiz."
          }
        }
      }
    },
