          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Бесплатный план позволяет добавить ещё %2$lld."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Bepul tarifda yana %2$lld ta eslatma qo‘shish mumkin."
