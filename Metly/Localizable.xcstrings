    "Work": {
      "comment": "Suggested card name",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ish"
          }
        }
      }
    },
    "Work phone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочий телефон"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ish telefoni"
          }
        }
      }
    },
    "Works without internet. Contact only, no analytics or Connect.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает без интернета. Только контакт, без аналитики и обмена."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetsiz ishlaydi. Faqat kontakt, analitika va almashishsiz."
          }
        }
      }
    },
    "Writes an email. Touch and hold to copy.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Написать письмо. Коснитесь и удерживайте, чтобы скопировать."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Email yozadi. Nusxalash uchun bosib turing."
          }
        }
      }
    },
    "Yearly": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовая"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yillik"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчера"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecha"
          }
        }
      }
    },
    "You and %@ are connected. Add context while it’s fresh.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы и %@ обменялись визитками. Добавьте подробности, пока всё свежо в памяти."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz va %@ vizitka almashdingiz. Esingizda borida tafsilotlarni qo‘shing."
          }
        }
      }
    },
    "You can add up to %lld contacts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно добавить не больше %lld контактов"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘pi bilan %lld ta kontakt qo‘shish mumkin"
          }
        }
      }
    },
    "You can add up to %lld contacts.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно добавить не больше %lld контактов."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘pi bilan %lld ta kontakt qo‘shish mumkin."
          }
        }
      }
    },
    "You can also put it on the Lock Screen or the Action button.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его также можно добавить на экран блокировки или на кнопку действия."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni Qulf ekraniga yoki Harakat tugmasiga ham qo‘yishingiz mumkin."
          }
        }
      }
    },
    "You can change everything later in the editor.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё это можно изменить позже в редакторе."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammasini keyinroq muharrirda o‘zgartirishingiz mumkin."
          }
        }
      }
    },
    "You can save up to %lld contacts.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно сохранить не больше %lld контактов."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘pi bilan %lld ta kontaktni saqlash mumkin."
          }
        }
      }
    },
    "You can save up to %lld phone numbers.": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно сохранить не больше %lld номеров телефона."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko‘pi bilan %lld ta telefon raqamini saqlash mumkin."
          }
        }
      }
    },
    "You can sign back in with Apple or Google.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сможете снова войти через Apple или Google."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple yoki Google orqali qayta kirishingiz mumkin."
          }
        }
      }
    },
    "You didn’t add anyone at this event.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы никого не добавили на этом мероприятии."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tadbirda hech kimni qo‘shmadingiz."
          }
        }
      }
    },
    "You met %@ at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You met %1$@ at %2$@."
          }
        },
        "ru": {
          "stringUnit": {
