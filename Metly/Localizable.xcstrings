    },
    "Used for Connect, your QR code and sharing until the event ends.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для обмена, вашего QR-кода и отправки, пока идёт мероприятие."
          }
        },
        "uz": {
