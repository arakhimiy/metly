    },
    "Swipe down from the top-right corner of the screen.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вниз от правого верхнего угла экрана."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranning yuqori o‘ng burchagidan pastga suring."
          }
        }
      }
    },
    "Swipe left or touch and hold a person for more actions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните человека влево или нажмите и удерживайте, чтобы увидеть другие действия."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa amallar uchun kishini chapga suring yoki bosib turing."
          }
        }
      }
    },
    "Swipe right on a reminder to mark it done, or left to snooze it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните напоминание вправо, чтобы отметить выполненным, или влево, чтобы отложить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajarildi deb belgilash uchun eslatmani o‘ngga, kechiktirish uchun chapga suring."
          }
        }
      }
    },
