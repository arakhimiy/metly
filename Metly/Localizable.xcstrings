          }
        }
      }
    },
    "Allow camera access to scan QR codes and paper business cards.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере, чтобы сканировать QR-коды и бумажные визитки."
