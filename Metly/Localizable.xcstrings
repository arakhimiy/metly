          "stringUnit": {
            "state": "translated",
            "value": "Bosh ekrandagi bo‘sh joyni ilovalar qimirlay boshlaguncha bosib turing."
          }
        }
      }
    },
    "Touch and hold an empty area, then tap Add a Control.": {
      "localizations": {
        "ru": {
