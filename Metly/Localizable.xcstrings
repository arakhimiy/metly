    "Uzbek voice notes aren’t available yet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовые заметки на узбекском пока недоступны."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O‘zbek tilida ovozli izohlar hozircha mavjud emas."
          }
        }
      }
    },
    "Values come from your profile. Change privacy there.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные берутся из профиля. Настройки приватности меняются там."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar profilingizdan olinadi. Maxfiylikni o‘sha yerda o‘zgartiring."
          }
        }
      }
    },
    "Values come from your profile. Private fields never appear on a card. Connections fields show only in the app to people you’ve connected with.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные берутся из профиля. Поля «Только мне» никогда не попадают на визитку. Поля «Контактам» видны только в приложении тем, с кем вы обменялись визитками."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma’lumotlar profilingizdan olinadi. “Faqat men” maydonlari vizitkada hech qachon ko‘rinmaydi. “Tanishlarga” maydonlari faqat ilovada siz bilan vizitka almashganlarga ko‘rinadi."
          }
        }
      }
    },
    "View": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть"
          }
        },
