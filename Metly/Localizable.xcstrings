    "Allow Local Network access in Settings › %@ to find people nearby. You can still show your QR code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы находить людей рядом, разрешите доступ к локальной сети в Настройках › %@. Вы по-прежнему можете показать свой QR-код."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaqin atrofdagi odamlarni topish uchun Sozlamalar › %@ bo‘limida Mahalliy tarmoqqa ruxsat bering. QR kodingizni baribir ko‘rsatishingiz mumkin."
          }
        }
      }
    },
    "Allow Notifications": {
      "localizations": {
